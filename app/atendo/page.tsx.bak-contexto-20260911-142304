"use client";

import { useState } from "react";
import Link from "next/link";
import ChatBubble from "@/components/chat/ChatBubble";
import QuickSuggestions from "@/components/chat/QuickSuggestions";
import ChatInput from "@/components/chat/ChatInput";
import { SUGESTOES_RAPIDAS } from "@/lib/constants";
import { ArrowLeft, ExternalLink, Sparkles } from "lucide-react";

interface Fonte {
  nome: string;
  orgao?: string | null;
  url: string;
  revisada_em?: string | null;
}

interface Mensagem {
  id: string;
  autor: "atendo" | "usuario";
  texto: string;
  fonte?: Fonte | null;
}

const MENSAGEM_INICIAL: Mensagem = {
  id: "inicial",
  autor: "atendo",
  texto:
    "Olá, eu sou o Atendo. Conte o que você precisa — posso ajudar a encontrar o próximo passo.",
};

export default function AtendoPage() {
  const [mensagens, setMensagens] = useState<Mensagem[]>([
    MENSAGEM_INICIAL,
  ]);

  const enviarMensagem = async (texto: string) => {
    if (!texto.trim()) return;

    const doUsuario: Mensagem = {
      id: crypto.randomUUID(),
      autor: "usuario",
      texto,
    };

    setMensagens((atual) => [...atual, doUsuario]);

    try {
      const response = await fetch("/api/atendo/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ mensagem: texto }),
      });

      const data = await response.json();

      if (response.status === 401) {
        window.location.href = "/auth?next=%2Fatendo";
        return;
      }

      if (!response.ok) {
        const resposta: Mensagem = {
          id: crypto.randomUUID(),
          autor: "atendo",
          texto:
            data?.error ||
            "Não consegui consultar minha base oficial agora. Tente novamente em alguns instantes.",
        };

        setMensagens((atual) => [...atual, resposta]);
        return;
      }

      const resposta: Mensagem = {
        id: crypto.randomUUID(),
        autor: "atendo",
        texto:
          data.resposta ||
          "Não consegui encontrar essa orientação na minha base oficial neste momento.",
        fonte: data.fonte || null,
      };

      setMensagens((atual) => [...atual, resposta]);
    } catch {
      const resposta: Mensagem = {
        id: crypto.randomUUID(),
        autor: "atendo",
        texto:
          "Não consegui consultar minha base oficial agora. Tente novamente em alguns instantes.",
      };

      setMensagens((atual) => [...atual, resposta]);
    }
  };

  const formatarData = (data?: string | null) => {
    if (!data) return null;

    const partes = data.split("-");

    if (partes.length !== 3) return data;

    return `${partes[2]}/${partes[1]}/${partes[0]}`;
  };

  return (
    <main className="min-h-dvh bg-[#F8FAFC] text-[#1E293B] flex justify-center items-center">
      <div className="w-full max-w-md bg-[#F8FAFC] min-h-dvh sm:min-h-[844px] sm:rounded-3xl shadow-xl flex flex-col relative overflow-hidden border border-slate-200/60">
        
        {/* Header */}
        <header className="flex items-center gap-3 border-b border-slate-100 bg-white px-5 py-4 shadow-sm">
          <Link
            href="/"
            aria-label="Voltar"
            className="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:text-[#1E293B] hover:bg-slate-100 transition-colors"
          >
            <ArrowLeft className="h-5 w-5" />
          </Link>

          <div className="flex items-center gap-3">
            <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-[#0F766E]/10 text-[#0F766E]">
              <Sparkles size={18} className="stroke-[2]" />
            </div>

            <div>
              <p className="font-bold text-[#1E293B] text-sm tracking-tight flex items-center gap-1.5">
                Atendo <span className="text-[#0F766E]">✨</span>
              </p>

              <p className="text-[11px] text-[#0F766E] font-medium">
                Assistente do RECOMEÇO
              </p>
            </div>
          </div>
        </header>

        {/* Histórico de Mensagens */}
        <div className="flex flex-1 flex-col gap-4 overflow-y-auto px-5 py-6">
          {mensagens.map((m) => (
            <div key={m.id} className="space-y-2">
              <ChatBubble autor={m.autor}>{m.texto}</ChatBubble>

              {/* Fonte oficial */}
              {m.autor === "atendo" && m.fonte && (
                <div className="ml-2 max-w-[92%] rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                  <div className="flex items-start gap-3">
                    <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#0F766E]/10 text-[#0F766E]">
                      <ExternalLink className="h-4 w-4" />
                    </div>

                    <div className="min-w-0 flex-1">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-[#0F766E]">
                        Fonte oficial
                      </p>

                      <p className="mt-1 text-sm font-semibold text-[#1E293B]">
                        {m.fonte.nome}
                      </p>

                      {m.fonte.orgao && (
                        <p className="mt-0.5 text-xs text-slate-500">
                          {m.fonte.orgao}
                        </p>
                      )}

                      {m.fonte.revisada_em && (
                        <p className="mt-2 text-[11px] text-slate-400">
                          Informação revisada em{" "}
                          {formatarData(m.fonte.revisada_em)}
                        </p>
                      )}

                      <a
                        href={m.fonte.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-[#0F766E]/10 px-3 py-2 text-xs font-semibold text-[#0F766E] transition-colors hover:bg-[#0F766E]/15"
                      >
                        Consultar fonte oficial
                        <ExternalLink className="h-3.5 w-3.5" />
                      </a>
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        {/* Rodapé */}
        <div className="space-y-3 border-t border-slate-100 bg-white px-5 py-4 shadow-sm">
          <QuickSuggestions
            sugestoes={SUGESTOES_RAPIDAS}
            onEscolher={enviarMensagem}
          />

          <ChatInput onEnviar={enviarMensagem} />
        </div>
      </div>
    </main>
  );
}
