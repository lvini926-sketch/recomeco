"use client";

import { useState } from "react";
import Link from "next/link";
import ChatBubble from "@/components/chat/ChatBubble";
import QuickSuggestions from "@/components/chat/QuickSuggestions";
import ChatInput from "@/components/chat/ChatInput";
import { SUGESTOES_RAPIDAS } from "@/lib/constants";
import { ArrowLeft, Sparkles } from "lucide-react";

interface Mensagem {
  id: string;
  autor: "atendo" | "usuario";
  texto: string;
}

const MENSAGEM_INICIAL: Mensagem = {
  id: "inicial",
  autor: "atendo",
  texto: "OlÃ¡, eu sou o Atendo. Conte o que vocÃª precisa â€” posso ajudar a encontrar o prÃ³ximo passo.",
};

function gerarResposta(texto: string): string {
  const mensagem = texto.toLowerCase();

  if (
    mensagem.includes("documento") ||
    mensagem.includes("rg") ||
    mensagem.includes("cpf") ||
    mensagem.includes("certidÃ£o")
  ) {
    return "Posso ajudar com documentaÃ§Ã£o. O primeiro passo Ã© identificar qual documento vocÃª precisa emitir ou regularizar. Posso te orientar sobre RG, CPF, certidÃµes e outros documentos.";
  }

  if (
    mensagem.includes("trabalho") ||
    mensagem.includes("emprego") ||
    mensagem.includes("vaga") ||
    mensagem.includes("currÃ­culo") ||
    mensagem.includes("curso")
  ) {
    return "Posso ajudar com trabalho e qualificaÃ§Ã£o. Podemos organizar os prÃ³ximos passos para procurar emprego, preparar seu currÃ­culo, encontrar cursos e buscar oportunidades de reinserÃ§Ã£o profissional.";
  }

  if (
    mensagem.includes("moradia") ||
    mensagem.includes("casa") ||
    mensagem.includes("aluguel") ||
    mensagem.includes("onde morar")
  ) {
    return "Posso ajudar com moradia. Podemos organizar os prÃ³ximos passos para encontrar um lugar seguro para morar, verificar programas de apoio e separar os documentos necessÃ¡rios.";
  }

  if (
    mensagem.includes("cras") ||
    mensagem.includes("assistÃªncia") ||
    mensagem.includes("assistencia") ||
    mensagem.includes("escritÃ³rio social") ||
    mensagem.includes("escritorio social") ||
    mensagem.includes("ajuda")
  ) {
    return "Posso ajudar a encontrar caminhos de assistÃªncia social. Podemos verificar serviÃ§os como CRAS, EscritÃ³rio Social e outras formas de apoio disponÃ­veis para sua situaÃ§Ã£o.";
  }

  if (
    mensagem.includes("saÃºde") ||
    mensagem.includes("saude") ||
    mensagem.includes("mÃ©dico") ||
    mensagem.includes("medico") ||
    mensagem.includes("hospital") ||
    mensagem.includes("psicolÃ³gico") ||
    mensagem.includes("psicologico")
  ) {
    return "Posso ajudar com informaÃ§Ãµes sobre acesso Ã  saÃºde. Podemos organizar os prÃ³ximos passos para buscar atendimento mÃ©dico, psicolÃ³gico ou outros serviÃ§os da rede pÃºblica.";
  }

  return "Entendi. Posso te ajudar a encontrar o prÃ³ximo passo. Tente me contar um pouco mais sobre o que vocÃª precisa, por exemplo: documentos, trabalho, moradia, assistÃªncia ou saÃºde.";
}

export default function AtendoPage() {
  const [mensagens, setMensagens] = useState<Mensagem[]>([
    MENSAGEM_INICIAL,
  ]);

  const enviarMensagem = async (texto: string) => {
    if (!texto.trim()) return;

    const doUsuario: Mensagem = {
      id: crypto.randomUUID(),
      autor: "usuario",
      texto,
    };

    setMensagens((atual) => [...atual, doUsuario]);

    try {
      const response = await fetch("/api/atendo/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ mensagem: texto }),
      });

      const data = await response.json();

      const resposta: Mensagem = {
        id: crypto.randomUUID(),
        autor: "atendo",
        texto:
          data.resposta ||
          "Não consegui encontrar essa orientação na minha base oficial neste momento.",
      };

      setMensagens((atual) => [...atual, resposta]);
    } catch {
      const resposta: Mensagem = {
        id: crypto.randomUUID(),
        autor: "atendo",
        texto:
          "Não consegui consultar minha base oficial agora. Tente novamente em alguns instantes.",
      };

      setMensagens((atual) => [...atual, resposta]);
    }
  };

  return (
    <main className="min-h-dvh bg-[#F8FAFC] text-[#1E293B] flex justify-center items-center">
      <div className="w-full max-w-md bg-[#F8FAFC] min-h-dvh sm:min-h-[844px] sm:rounded-3xl shadow-xl flex flex-col relative overflow-hidden border border-slate-200/60">
        
        {/* Header Redesenhado */}
        <header className="flex items-center gap-3 border-b border-slate-100 bg-white px-5 py-4 shadow-xs">
          <Link
            href="/"
            aria-label="Voltar"
            className="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:text-[#1E293B] hover:bg-slate-100 transition-colors"
          >
            <ArrowLeft className="h-5 w-5" />
          </Link>

          <div className="flex items-center gap-3">
            <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-[#0F766E]/10 text-[#0F766E]">
              <Sparkles size={18} className="stroke-[2]" />
            </div>
            <div>
              <p className="font-bold text-[#1E293B] text-sm tracking-tight flex items-center gap-1.5">
                Atendo <span className="text-[#0F766E]">âœ¨</span>
              </p>
              <p className="text-[11px] text-[#0F766E] font-medium">
                Assistente do RECOMEÃ‡O
              </p>
            </div>
          </div>
        </header>

        {/* HistÃ³rico de Mensagens */}
        <div className="flex flex-1 flex-col gap-3 overflow-y-auto px-5 py-6">
          {mensagens.map((m) => (
            <ChatBubble key={m.id} autor={m.autor}>
              {m.texto}
            </ChatBubble>
          ))}
        </div>

        {/* RodapÃ© com SugestÃµes e Input */}
        <div className="space-y-3 border-t border-slate-100 bg-white px-5 py-4 shadow-sm">
          <QuickSuggestions
            sugestoes={SUGESTOES_RAPIDAS}
            onEscolher={enviarMensagem}
          />

          <ChatInput onEnviar={enviarMensagem} />
        </div>

      </div>
    </main>
  );
}