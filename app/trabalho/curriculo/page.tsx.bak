"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { Shield, ArrowLeft, Mail, Lock, User, Loader2 } from "lucide-react";
import { createClient } from "@/lib/supabase/browser";

export default function AuthPage() {
  const router = useRouter();
  const [isSignUp, setIsSignUp] = useState(false);
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [nome, setNome] = useState("");
  const [tipo, setTipo] = useState<"familiar" | "egresso">("egresso");
  const [loading, setLoading] = useState(false);
  const [errorMsg, setErrorMsg] = useState("");

  const handleAuth = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setErrorMsg("");

    const supabase = createClient();

    try {
      if (isSignUp) {
        const { error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            data: {
              nome,
              tipo,
            },
          },
        });

        if (error) throw error;
        alert("Conta criada com sucesso! Verifique seu e-mail se necessário ou faça login.");
        setIsSignUp(false);
      } else {
        const { error } = await supabase.auth.signInWithPassword({
          email,
          password,
        });

        if (error) throw error;
        router.push("/painel");
      }
    } catch (err: any) {
      setErrorMsg(err.message || "Ocorreu um erro na autenticação.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="min-h-dvh bg-[#F8FAFC] text-[#1E293B] flex justify-center items-center">
      <div className="w-full max-w-md bg-[#F8FAFC] min-h-dvh sm:min-h-[844px] sm:rounded-3xl shadow-xl flex flex-col relative overflow-hidden border border-slate-200/60 p-6 justify-between">
        
        {/* Topo */}
        <div>
          <div className="flex items-center justify-between mb-6">
            <Link
              href="/"
              className="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-[#1E293B] transition-colors"
            >
              <ArrowLeft className="h-4 w-4" /> Voltar ao início
            </Link>
          </div>

          <div className="flex flex-col items-center text-center mb-8">
            <div className="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#0F766E]/10 text-[#0F766E] shadow-xs border border-[#0F766E]/20">
              <Shield size={28} className="stroke-[1.75]" />
            </div>
            <h1 className="text-2xl font-extrabold tracking-tight text-[#1E293B]">
              RECOMEÇO
            </h1>
            <p className="mt-1 text-xs text-slate-500 font-medium">
              {isSignUp ? "Crie sua conta para salvar seu progresso." : "Entre para acessar seu painel e trilha."}
            </p>
          </div>

          {errorMsg && (
            <div className="mb-4 rounded-xl bg-red-50 border border-red-200 p-3 text-xs text-red-600 font-medium text-center">
              {errorMsg}
            </div>
          )}

          {/* Formulário */}
          <form onSubmit={handleAuth} className="space-y-4">
            {isSignUp && (
              <>
                <div>
                  <label className="block text-xs font-bold text-[#1E293B] mb-1">Seu Nome</label>
                  <div className="relative">
                    <User className="absolute left-3.5 top-3 h-4 w-4 text-slate-400" />
                    <input
                      type="text"
                      required
                      value={nome}
                      onChange={(e) => setNome(e.target.value)}
                      placeholder="Como deseja ser chamado"
                      className="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-3.5 py-2.5 text-xs text-[#1E293B] focus:outline-none focus:ring-2 focus:ring-[#0F766E]/30 focus:border-[#0F766E]"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-xs font-bold text-[#1E293B] mb-1">Você é:</label>
                  <div className="grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      onClick={() => setTipo("egresso")}
                      className={`py-2 px-3 rounded-xl text-xs font-bold border transition-all ${
                        tipo === "egresso"
                          ? "bg-[#0F766E] text-white border-[#0F766E] shadow-xs"
                          : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
                      }`}
                    >
                      Egresso
                    </button>
                    <button
                      type="button"
                      onClick={() => setTipo("familiar")}
                      className={`py-2 px-3 rounded-xl text-xs font-bold border transition-all ${
                        tipo === "familiar"
                          ? "bg-[#0F766E] text-white border-[#0F766E] shadow-xs"
                          : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
                      }`}
                    >
                      Familiar
                    </button>
                  </div>
                </div>
              </>
            )}

            <div>
              <label className="block text-xs font-bold text-[#1E293B] mb-1">E-mail</label>
              <div className="relative">
                <Mail className="absolute left-3.5 top-3 h-4 w-4 text-slate-400" />
                <input
                  type="email"
                  required
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="seu@email.com"
                  className="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-3.5 py-2.5 text-xs text-[#1E293B] focus:outline-none focus:ring-2 focus:ring-[#0F766E]/30 focus:border-[#0F766E]"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-bold text-[#1E293B] mb-1">Senha</label>
              <div className="relative">
                <Lock className="absolute left-3.5 top-3 h-4 w-4 text-slate-400" />
                <input
                  type="password"
                  required
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••"
                  className="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-3.5 py-2.5 text-xs text-[#1E293B] focus:outline-none focus:ring-2 focus:ring-[#0F766E]/30 focus:border-[#0F766E]"
                />
              </div>
            </div>

            <button
              type="submit"
              disabled={loading}
              className="w-full mt-2 flex items-center justify-center gap-2 rounded-xl bg-[#0F766E] py-3 text-xs font-semibold text-white shadow-sm hover:bg-[#0F766E]/90 transition-all disabled:opacity-50 active:scale-98"
            >
              {loading && <Loader2 className="h-4 w-4 animate-spin" />}
              {isSignUp ? "Criar Conta" : "Entrar na Plataforma"}
            </button>
          </form>
        </div>

        {/* Alternador de Modo */}
        <div className="text-center pt-4 border-t border-slate-200/60 mt-4">
          <p className="text-xs text-slate-500">
            {isSignUp ? "Já tem uma conta?" : "Ainda não tem cadastro?"}{" "}
            <button
              type="button"
              onClick={() => setIsSignUp(!isSignUp)}
              className="font-bold text-[#0F766E] hover:underline ml-1"
            >
              {isSignUp ? "Fazer login" : "Criar agora"}
            </button>
          </p>
        </div>

      </div>
    </main>
  );
}