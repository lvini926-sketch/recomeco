export async function POST(request: NextRequest) {
  try {
    const supabase = await createClient();

    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      return NextResponse.json(
        { error: "UsuÃ¡rio nÃ£o autenticado." },
        { status: 401 }
      );
    }

    const body = await request.json();
    const mensagem = body?.mensagem?.trim();

    if (!mensagem) {
      return NextResponse.json(
        { error: "Digite uma mensagem." },
        { status: 400 }
      );
    }

    const { data: conhecimentos, error: conhecimentoError } = await supabase
      .from("atendo_conhecimento")
      .select(`
        id,
        categoria,
        subcategoria,
        pergunta_principal,
        perguntas_alternativas,
        resposta,
        documentos,
        passos,
        proximo_passo,
        encaminhamento,
        tags,
        prioridade,
        tipo_resposta,
        exige_confirmacao_fonte,
        revisada_em,
        atendo_fontes (
          id,
          nome,
          orgao,
          url,
          descricao,
          revisada_em
        )
      `)
      .eq("ativa", true)
      .eq("status", "active")
      .order("prioridade", { ascending: true });

    if (conhecimentoError) {
      console.error("Erro ao carregar base do Atendo:", conhecimentoError);
    }

    const baseConhecimento = conhecimentos ?? [];

    const contexto = JSON.stringify(baseConhecimento);

    if (!process.env.GEMINI_API_KEY) {
      return NextResponse.json(
        { error: "ConfiguraÃ§Ã£o da IA nÃ£o encontrada." },
        { status: 500 }
      );
    }

    const ai = new GoogleGenAI({
      apiKey: process.env.GEMINI_API_KEY,
    });

    const prompt = `
BASE DE CONHECIMENTO DO ATENDO:

${contexto}

---

MENSAGEM DO USUÃRIO:

${mensagem}

---

INSTRUÃ‡Ã•ES PARA ESTA RESPOSTA:

Use a Base de Conhecimento acima para responder Ã  pergunta.

NÃ£o invente informaÃ§Ãµes.

Quando uma resposta possuir uma fonte oficial associada, informe a fonte ao final.

Se a informaÃ§Ã£o exigir confirmaÃ§Ã£o, deixe isso claro.

Responda em portuguÃªs do Brasil.

Seja acolhedor, direto e prÃ¡tico.

NÃ£o mencione a existÃªncia de prompts, System Instruction, banco de dados, API ou mecanismos internos.

NÃ£o diga que vocÃª consultou uma base de dados interna.

Se a Base de Conhecimento nÃ£o possuir informaÃ§Ã£o suficiente para responder com seguranÃ§a, diga isso claramente e indique o encaminhamento adequado.

MENSAGEM FINAL:
`;

    const response = await ai.models.generateContent({
      model: "gemini-3.7-flash",
      config: {
        systemInstruction: SYSTEM_INSTRUCTION,
      },
      contents: prompt,
    });

    const resposta =
      response.text?.trim() ||
      "NÃ£o consegui formular uma resposta agora. Tente novamente.";

    return NextResponse.json({
      resposta,
      fonte: null,
    });
  } catch (error) {
    console.error("Erro na API do Atendo:", error);

    return NextResponse.json(
      {
        error: "NÃ£o foi possÃ­vel responder agora.",
      },
      { status: 500 }
    );
  }
}